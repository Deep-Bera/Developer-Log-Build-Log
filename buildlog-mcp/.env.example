#this file will be neccessory if you are using any of the MCP clients for accessing your MCP server other wise the project will work fine

# BuildLog MCP Server Configuration
# Copy this to .env and set your values

# The backend API URL
BUILDLOG_API_URL=http://localhost:5701

# Your JWT authentication token from BuildLog (required for create_log and list_projects in Cursor)
# You can copy this from browser localStorage: localStorage.getItem("token")
BUILDLOG_TOKEN=
